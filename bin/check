SKIP_SUFFIX = ('.png', '.webp', '.jpg', '.jpeg', '.gif', '.ico', '.svg', '.woff', '.woff2', '.ttf', '.pdf', '.lock')
SKIP_PATH = re.compile(r'(^|/)(vendor|node_modules)/|^src/public/build/|^src/storage/|^src/bootstrap/cache/|^docs/(guide|flow)\.html$')

