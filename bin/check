#!/usr/bin/env python3
"""
推理手帳の決まりを機械で確かめる（.claude/rules/ に書いた決まりのうち、機械で判定できるもの）。
AI のフック（.claude/settings.json）と git のコミット前チェック（.githooks/pre-commit）から呼ばれる。人が手で動かしてもよい。

  bin/check rules [ファイル...]   決まりの違反を探す（ファイルを渡さなければ、git で管理している物とまだ入れていない新しい物の全部。
                                  app.css の独自のクラス・行数の上限・言葉の決まり・コードのコメントの抜け＝bin/code_comments.py も）
  bin/check docs                  ドキュメントのリンク切れ・使っていない画像・HTML 版（docs/guide.html・docs/flow.html）の作り直し忘れ
  bin/check staged                コミット前：コミットするファイルの決まり＋秘密の値＋整形＋テスト（＋ドキュメント）
  bin/check worktree              作業の終わり：直したファイルの決まり＋秘密の値＋画面のビルド＋整形＋テスト（＋ドキュメント）

違反があれば理由と直し方を出して、終了コード 1 で終わる。PHP はホストにないので、整形とテストはコンテナの中で動かす。
手本は Baker Street English の bin/check。決まりを足すときは、下の表（RULES・WORD_RULES・SIZE_LIMITS・CSS_OK_AT）に1行足し、
理由と「→ 直し方」を必ず書く。例外は理由つきの表（ALLOW・WORD_ALLOW・ALLOW_SIZE）に書く（チェックそのものを弱めない）。
"""
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
os.chdir(ROOT)
sys.dont_write_bytecode = True  # bin/__pycache__ を作らない
sys.path.insert(0, str(ROOT / 'bin'))
import code_comments  # noqa: E402  コードのコメントの決まり（.claude/rules/code-comments.md）


def sh(cmd):
    """シェルのコマンドを動かして、結果（終了コード・出力）を返す"""
    return subprocess.run(cmd, shell=True, capture_output=True, text=True)


def git_files(args):
    """git に聞いたファイルの一覧のうち、今あるものだけを返す（消したファイルは確かめようがないので外す）"""
    out = sh(f"git {args}").stdout
    return [f for f in out.split('\n') if f and Path(f).exists()]


