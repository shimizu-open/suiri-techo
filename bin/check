# ---------- 言葉の決まり（docs/design/words.md の「3. 使わない言葉」） ----------
# 画面に出る文言から探す。否定の注意書き（「診断ではありません」など）と作品名『…』は、その部分を消してから探す。
SCREEN_WORDS = (r'診断|治療|治[らりるれろ]|効[かきくけ]|処方|おすすめの施術|患者|顧客|カルテ'
                r'|頭が良くなる|思考力が伸びる|脳トレ|認知症予防|無知の無知|連続\s*[0-9０-９]+\s*日|連続記録|ランキング')
# 否定の言い方。下の段は、やわらかい話し言葉の否定（「連続記録やポイントはないよ」「連続記録なし」「点数はつけない」「順位は出さない」）。
# 「〜がないと続かない」「〜しないと」のような、ほしがる・せかす言い方は否定ではないので通さない（後ろに「と」が続くものは外す）
NEGATION = (r'(ではありません|ではない|ではなく|じゃない|しません|できません|行いません|いたしません|目的とし(て)?いません|目的としません'
            r'|[はもが]ありません|使えません|使いません|使わない|使わず|書かない|書かず|入力しない|お約束しません|約束しません|保証しません|作りません|禁止'
            r'|[はもが]な[いし](?!と)|(?<![ぁ-ゖ])なし|しない(?!と)|[付つ]けない|作らない|出さない|数えない)')
SCREEN_MASK = [
    COMMENT_PART,
    r'『[^』]*』',                                    # 作品名（『入院患者』など）
    r'"(story_ja|story_en|origin|quote_source|quote_en|chapter)"\s*:\s*"[^"]*"',  # 教材の JSON の作品名・出典・英語の引用の欄
    rf'(?:{SCREEN_WORDS})[^。！？!?\n]{{0,30}}?{NEGATION}',  # 否定の注意書き（「病気の診断・治療・予防を目的としていません」）
]
CODE_MASK = [
    COMMENT_PART,
    r'(?i:\bclient[_ -]?(id|secret|ip)s?\b)|\bclient(Id|Secret|Ip)\b|GOOGLE_CLIENT_\w+|getClientIp|Http\\Client\b|\w*ClientException',
    r'\bclient(X|Y|Width|Height|Left|Top)\b|getBoundingClientRect|getClientRects',  # 画面の位置（ブラウザの決まった名前）
]
# (名前, 対象のパスの正規表現, 探す正規表現, 消してから探す部分の正規表現の一覧, 見逃す行の正規表現 or None, 直し方)
WORD_RULES = [
    ('画面で使わない言葉',
     r'^src/(resources/views/.*\.blade\.php|config/(suiri|watson|legal|ai_connect)\.php|database/data/guide/.*\.json)$',
