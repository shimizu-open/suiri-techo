     '別の言い方にする（オーナーの決まり。.claude/rules/docs.md）'),
]

# 言葉の決まりの例外（理由つき）：このファイルの、この正規表現に当たる行は見逃す
WORD_ALLOW = {
    ('画面で使わない言葉', 'src/config/watson.php'): [
        (r"^\s*'[^']{1,15}',?\s*$|^\s*'(words|patterns|terms|keywords|detect)'\s*=>",
