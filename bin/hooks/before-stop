#!/usr/bin/env python3
"""
Claude Code のフック（Stop）：AI が作業を終えて返事をする前に、直したファイル全体を確かめる（bin/check worktree）。
決まりの違反・秘密の値・画面のビルド・整形・テスト（・ドキュメント）のどれかが通らなければ、終了コード 2 で止めて AI に直させる。
直しても通らないときに同じことを繰り返さないよう、2回目（stop_hook_active）は止めずに知らせるだけにする
"""
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
# Claude Code から渡される状態を読む（読めなければ空として扱う）
try:
    data = json.load(sys.stdin)
except Exception:
    data = {}

r = subprocess.run([str(ROOT / 'bin/check'), 'worktree'], cwd=ROOT, capture_output=True, text=True)
# 通れば、そのまま終えてよい
if r.returncode == 0:
    sys.exit(0)
msg = r.stderr or r.stdout
# 2回目（すでに一度止めた）なら止めず、利用者に伝えるよう AI に頼む
if data.get('stop_hook_active'):
    print('（作業の終わりのチェックがまだ通っていません。利用者に伝えてください）\n' + msg, file=sys.stderr)
    sys.exit(0)
print('作業を終える前のチェックが通っていません。直してから終えてください：\n' + msg, file=sys.stderr)
sys.exit(2)
